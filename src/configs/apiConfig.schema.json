{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ramsuthar305/sancus/api-config.schema.json",
  "title": "Sancus service config",
  "type": "object",
  "required": ["service", "apis"],
  "additionalProperties": false,
  "definitions": {
    "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "CONNECT", "TRACE"] },
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add": { "type": "object", "additionalProperties": { "type": "string" } },
        "remove": { "type": "array", "items": { "type": "string" } }
      }
    },
    "policies": { "type": "object", "additionalProperties": true }
  },
  "properties": {
    "service": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "anyOf": [{ "required": ["host"] }, { "required": ["nodes"] }],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https?://" } },
        "hosts": { "type": "array", "items": { "type": "string" } },
        "rewrite": {
          "type": "object", "required": ["from", "to"], "additionalProperties": false,
          "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
        },
        "timeout": { "type": "integer", "minimum": 1 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "circuitBreaker": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "errorThresholdPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
            "volumeThreshold": { "type": "integer", "minimum": 1 },
            "resetTimeout": { "type": "integer", "minimum": 1 }
          }
        },
        "headers": { "$ref": "#/definitions/headers" },
        "policies": { "$ref": "#/definitions/policies" }
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "routes"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "methods"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "pattern": "^/" },
                "methods": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/method" } },
                "bypass": { "type": "array", "items": { "type": "string", "enum": ["AUTH", "GEO_FENCE"] } },
                "resolveUser": { "type": "boolean" },
                "authorization": { "type": "array", "items": { "type": "object" } },
                "rateLimit": {
                  "type": "object", "additionalProperties": false,
                  "properties": {
                    "perMinute": { "type": "integer", "minimum": 1 },
                    "perDay": { "type": "integer", "minimum": 1 },
                    "key": { "type": "string", "enum": ["API_KEY", "USER", "IP", "USER_OR_IP", "IP_USER"] },
                    "group": { "type": "string" },
                    "hideHeaders": { "type": "boolean" }
                  }
                },
                "cache": {
                  "type": "object", "required": ["strategy", "ttl"], "additionalProperties": false,
                  "properties": {
                    "strategy": { "type": "string", "enum": ["LRU", "LFU", "SWR"] },
                    "ttl": { "type": "integer", "minimum": 1 },
                    "key": { "type": "string", "enum": ["PATH", "PATH_QUERY", "PATH_QUERY_USER"] },
                    "browserTtl": { "type": "integer", "minimum": 0 },
                    "varyHeaders": { "type": "array", "items": { "type": "string" } },
                    "statusCodes": { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 599 } },
                    "shared": { "type": "boolean" }
                  }
                },
                "headers": { "$ref": "#/definitions/headers" },
                "policies": { "$ref": "#/definitions/policies" }
              }
            }
          }
        }
      }
    }
  }
}

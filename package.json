{
  "name": "sancus",
  "version": "2.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "export NODE_ENV=production && concurrently \"npx tsc --watch\" \"nodemon -q dist/index.js\"",
    "build": "rimraf ./build && tsc",
    "start": "node -r newrelic build/index.js",
    "test": "jest",
    "check": "node build/commands/check.js",
    "test:e2e": "node tests/e2e/run.js",
    "lint": "eslint . --ext .ts",
    "lint-and-fix": "eslint . --ext .ts --fix",
    "prettier-watch": "onchange 'src/**/*.ts' -- prettier --write {{changed}}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramsuthar305/Sancus.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ramsuthar305/Sancus/issues"
  },
  "homepage": "https://github.com/ramsuthar305/Sancus#readme",
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.2.1",
    "@types/opossum": "^8.1.9",
    "@types/point-in-polygon": "^1.1.5",
    "concurrently": "^8.2.2",
    "eslint": "^8.4.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^30.2.0",
    "js-yaml": "^4.1.0",
    "nodemon": "^2.0.22",
    "onchange": "^7.1.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@types/http-proxy": "^1.17.11",
    "@types/multer": "^2.0.0",
    "@types/newrelic": "^9.14.5",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "http-proxy": "^1.18.1",
    "ioredis": "^5.8.2",
    "multer": "^2.0.2",
    "newrelic": "^12.6.0",
    "opossum": "^7.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "point-in-polygon": "^1.1.0",
    "prom-client": "^15.1.3",
    "rimraf": "^6.0.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "clearMocks": true,
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "types": [
              "node",
              "jest"
            ]
          }
        }
      ]
    }
  }
}
